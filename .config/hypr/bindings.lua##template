-- Launch Helium browser
o.bind("SUPER + B", "Helium", { launch = "helium-browser" })

-- Close window with Super + Q instead of Super + W
hl.unbind("SUPER + W")
o.bind("SUPER + Q", "Close window", hl.dsp.window.close())

{% if yadm.hostname == "bijibendiannao" %}
-- Laptop-only: clipboard manager on CTRL + SHIFT + X instead of Super + Ctrl + V
hl.unbind("SUPER + CTRL + V")
hl.unbind("SUPER + SHIFT + X")
o.bind("CTRL + SHIFT + X", "Clipboard manager", "omarchy-shell shell toggle omarchy.clipboard")
{% else %}
-- Clipboard manager on Super + Shift + X instead of Super + Ctrl + V
hl.unbind("SUPER + CTRL + V")
hl.unbind("SUPER + SHIFT + X")
o.bind("SUPER + SHIFT + X", "Clipboard manager", "omarchy-shell shell toggle omarchy.clipboard")
{% endif %}

-- Dictation (push-to-talk, hold to talk) on F1
hl.unbind("SUPER + SHIFT + D")
hl.unbind("F9")
hl.unbind("SUPER + CTRL + X")
-- F1 has no modifier, so Hyprland delivers both the press and the release.
hl.bind("F1", hl.dsp.global("anomaly.hex:dictation-F1"), { description = "Dictation (push-to-talk)" })

-- Annotate on F2: tap to start and stop, hold to draw
hl.bind("F2", hl.dsp.global("anomaly.hex:capture-F2"), { description = "Annotate (tap to start/stop, hold to draw)" })
{% if yadm.hostname == "bijibendiannao" %}

-- Laptop-only: open the Omarchy menu with CTRL + SPACE instead of SUPER + SPACE.
hl.unbind("SUPER + SPACE")
o.bind("CTRL + SPACE", "Omarchy menu", "omarchy-menu toggle")

-- Volume keys snap to the next multiple of 5 in the pressed direction:
-- 47 down -> 45, then 40; 47 up -> 50. Omarchy's stock raise/lower moves by 5
-- from wherever the volume is, which leaves it off-grid (e.g. 47 down -> 42).
-- The script hands the delta to omarchy-audio-output-volume, so the OSD and
-- sink handling (DSP sinks, mute-on-change) stay the same.
hl.unbind("XF86AudioRaiseVolume")
hl.unbind("XF86AudioLowerVolume")
local volume_snap = (os.getenv("HOME") or "") .. "/.local/bin/volume-snap"
o.bind("XF86AudioRaiseVolume", "Volume up", volume_snap .. " up", { locked = true, repeating = true })
o.bind("XF86AudioLowerVolume", "Volume down", volume_snap .. " down", { locked = true, repeating = true })
{% endif %}
