-- Screenshot on SUPER + SHIFT + S instead of PRINT
-- (SUPER + SHIFT + S was previously bound to Google Maps)
hl.unbind("PRINT")
hl.unbind("SUPER + SHIFT + S")
o.bind("SUPER + SHIFT + S", "Screenshot", "omarchy-capture-screenshot")

