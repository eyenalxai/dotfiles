{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "ulezot.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 1996,
          "lifeExpectancy": 70
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "amnezia-vpn"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "cpu",
          "type": "qml",
          "source": "~/.config/omarchy/bar/modules/resources.qml",
          "metric": "cpu"
        },
        {
          "id": "ram",
          "type": "qml",
          "source": "~/.config/omarchy/bar/modules/resources.qml",
          "metric": "ram"
        },
        {
          "id": "disk",
          "type": "qml",
          "source": "~/.config/omarchy/bar/modules/resources.qml",
          "metric": "disk",
          "mount": "/"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "ulsippoi.notifications"
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "ulsippoi.notifications"
  ]
}
