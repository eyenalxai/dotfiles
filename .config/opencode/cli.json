{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["@prevalentware/opencode-goal-plugin"],
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "session.message.user.previous": "alt+p,alt+k",
    "session.message.user.next": "alt+n,alt+j",
    "session.messages_last_user": "alt+end",
    "session.last": "ctrl+alt+g,end"
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "new_location": "inherit",
    "markdown": "rendered",
    "permissions": "autoaccept",
    "verbosity": "low",
    "image_preview": true,
    "grouping": "auto"
  },
  "debug": {
    "devtools": false
  },
  "diffs": {
    "view": "split"
  },
  "tabs": {
    "scope": "global",
    "layout": "vertical",
    "indicators": "status",
    "mode": "auto"
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "terminal": {
    "copy": "manual"
  },
  "animations": true,
  "scroll": {
    "acceleration": true,
    "speed": 6
  }
}
