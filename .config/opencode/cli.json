{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "session.message.user.previous": "alt+p,alt+k",
    "session.message.user.next": "alt+n,alt+j",
    "session.messages_last_user": "alt+end",
    "session.last": "ctrl+alt+g,end"
  },
  "attention": {
    "enabled": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "new_location": "launch"
  },
  "debug": {
    "devtools": false
  },
  "diffs": {
    "view": "split"
  },
  "tabs": {
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "terminal": {
    "copy": "manual"
  }
}
