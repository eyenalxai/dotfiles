{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 2
  },
  "mcp": {
    "servers": {
      "railway": {
        "command": [
          "railway",
          "mcp"
        ],
        "type": "local"
      },
      "reui": {
        "type": "remote",
        "url": "https://mcp.reui.io/api/mcp"
      },
      "browse": {
        "type": "local",
        "command": [
          "/home/ulezot/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  },
  "model": "opencode-go/deepseek-v4.1-flash",
  "plugins": [
    {
      "options": {
        "copyAll": true
      },
      "package": "github:anomalyco/rift#v0.0.13::path:plugins/opencode"
    }
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "opencode-go",
      "effect": "allow"
    }
  ]
}
