{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "railway": {
      "command": [
        "railway",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "opencode-go/deepseek-v4.1-flash",
  "plugins": [
    {
      "options": {
        "maxContext": 512000
      },
      "package": "./max-context"
    },
    {
      "options": {
        "copyAll": true
      },
      "package": "github:anomalyco/rift#v0.0.12::path:plugins/opencode"
    },
    "@prevalentware/opencode-goal-plugin",
    "./opencode-go-failover"
  ]
}