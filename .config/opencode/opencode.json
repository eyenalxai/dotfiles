{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 2
  },
  "mcp": {
    "servers": {
      "railway": {
        "command": [
          "railway",
          "mcp"
        ],
        "type": "local"
      },
      "reui": {
        "type": "remote",
        "url": "https://mcp.reui.io/api/mcp"
      }
    }
  },
  "model": "opencode-go/deepseek-v4.1-flash",
  "plugins": [
    {
      "options": {
        "copyAll": true
      },
      "package": "github:anomalyco/rift#v0.0.13::path:plugins/opencode"
    }
  ]
}
