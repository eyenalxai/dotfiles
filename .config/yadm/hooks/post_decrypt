#!/usr/bin/env bash
set -eo pipefail

HIST_DB="$HOME/.config/nushell/history.sqlite3"
LOCAL_PRE="$HOME/.config/nushell/history.sqlite3.local_pre_decrypt"

# Remove any lingering WAL/SHM files
rm -f "$HIST_DB-wal" "$HIST_DB-shm"

# Handle failure or cancellation of yadm decrypt (e.g. wrong passphrase)
if [ -n "$YADM_HOOK_EXIT" ] && [ "$YADM_HOOK_EXIT" -ne 0 ]; then
    if [ -f "$LOCAL_PRE" ] && [ ! -f "$HIST_DB" ]; then
        mv "$LOCAL_PRE" "$HIST_DB"
    fi
    exit 0
fi

# Two-way merge of local history with incoming decrypted history
if [ -f "$HIST_DB" ] && [ -f "$LOCAL_PRE" ] && command -v python3 >/dev/null 2>&1; then
    python3 - << 'EOF'
import sqlite3, os, tempfile

hist_db = os.path.expanduser("~/.config/nushell/history.sqlite3")
local_pre = os.path.expanduser("~/.config/nushell/history.sqlite3.local_pre_decrypt")

def fetch_rows(db_path):
    if not os.path.exists(db_path):
        return []
    try:
        conn = sqlite3.connect(db_path)
        cur = conn.cursor()
        cur.execute("PRAGMA table_info(history)")
        cols = [c[1] for c in cur.fetchall()]
        if not cols:
            conn.close()
            return []
        session_col = "session_id" if "session_id" in cols else "NULL"
        more_info_col = "more_info" if "more_info" in cols else "NULL"
        query = f"""
            SELECT command_line, start_timestamp, {session_col}, hostname, cwd, duration_ms, exit_status, {more_info_col}
            FROM history
        """
        cur.execute(query)
        rows = cur.fetchall()
        conn.close()
        return rows
    except Exception as e:
        print(f"Warning: could not read {db_path}: {e}")
        return []

incoming_rows = fetch_rows(hist_db)
local_rows = fetch_rows(local_pre)

seen = set()
merged = []

for r in incoming_rows + local_rows:
    if r[1] is not None:
        key = (r[0], r[1], r[3])  # (command_line, start_timestamp, hostname)
    else:
        key = (r[0], r[1], r[2], r[3], r[4], r[5], r[6])
    if key not in seen:
        seen.add(key)
        merged.append(r)

# Chronological order by start_timestamp
merged.sort(key=lambda r: (r[1] if r[1] is not None else 0))

# Create merged database
temp_fd, temp_path = tempfile.mkstemp(suffix=".sqlite3", dir=os.path.dirname(hist_db))
os.close(temp_fd)

try:
    out_conn = sqlite3.connect(temp_path)
    out_conn.execute("""
        CREATE TABLE history (
            id integer primary key autoincrement,
            command_line text not null,
            start_timestamp integer,
            session_id integer,
            hostname text,
            cwd text,
            duration_ms integer,
            exit_status integer,
            more_info text
        ) strict;
    """)
    out_conn.execute("CREATE INDEX idx_history_time on history(start_timestamp);")
    out_conn.execute("CREATE INDEX idx_history_cwd on history(cwd);")
    out_conn.execute("CREATE INDEX idx_history_exit_status on history(exit_status);")
    out_conn.execute("CREATE INDEX idx_history_cmd on history(command_line);")

    out_conn.executemany("""
        INSERT INTO history (command_line, start_timestamp, session_id, hostname, cwd, duration_ms, exit_status, more_info)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    """, merged)
    out_conn.commit()
    out_conn.execute("PRAGMA integrity_check;")
    out_conn.execute("PRAGMA wal_checkpoint(TRUNCATE);")
    out_conn.close()

    os.replace(temp_path, hist_db)
    if os.path.exists(local_pre):
        os.remove(local_pre)

    new_from_local = len(merged) - len(incoming_rows)
    print(f"✓ Nushell history merged: {len(incoming_rows)} from archive + {new_from_local} local unique = {len(merged)} total.")
except Exception as e:
    print(f"Error during merge: {e}")
    if os.path.exists(temp_path):
        os.remove(temp_path)
EOF
fi

# Clean up local backup if it still exists
rm -f "$LOCAL_PRE" "$HIST_DB-wal" "$HIST_DB-shm"

# Ensure proper permissions
if [ -f "$HIST_DB" ]; then
    chmod 600 "$HIST_DB"
fi

if pgrep -x nu >/dev/null 2>&1; then
    echo "Note: Running Nushell sessions must run 'exec nu' or restart to reload history."
fi
