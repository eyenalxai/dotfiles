#!/usr/bin/env bash
set -eo pipefail

HIST_DB="$HOME/.config/nushell/history.sqlite3"
LOCAL_PRE="$HOME/.config/nushell/history.sqlite3.local_pre_decrypt"

# 1. Flush any pending WAL writes in the active local database
if [ -f "$HIST_DB" ] && command -v sqlite3 >/dev/null 2>&1; then
    sqlite3 "$HIST_DB" "PRAGMA wal_checkpoint(TRUNCATE);" >/dev/null 2>&1 || true
fi

# 2. Preserve existing local database for two-way merging
if [ -f "$HIST_DB" ]; then
    cp -p "$HIST_DB" "$LOCAL_PRE"
fi

# 3. Unlink active files so running Nushell instances detach cleanly
# onto orphaned file descriptors and cannot overwrite or shadow the new file
rm -f "$HIST_DB" "$HIST_DB-wal" "$HIST_DB-shm"
