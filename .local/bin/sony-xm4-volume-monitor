#!/usr/bin/env nu
# sony-xm4-volume-monitor - keep Sony WH/WF-1000XM4 headphones at a fixed volume.
#
# WirePlumber restores a sink's last volume when the headset connects, which is
# often far too loud. This daemon watches `pactl subscribe`, detects XM4 sinks,
# sets them to the target volume, and re-applies it briefly in case WirePlumber
# restores the old volume again after the change.
#
# Usage: sony-xm4-volume-monitor [--volume 30%]
# Managed by: ~/.config/systemd/user/sony-xm4-volume.service

const default_volume = "30%"
const known_mac = "AC:80:0A:EA:90:62"
const sony_vendor_id = "054c"
const rescan_delay = 2sec
const stabilization_delays = [150ms 350ms]

def log [message: string] {
    let timestamp = date now | format date "%Y-%m-%d %H:%M:%S"
    print $"[($timestamp)] ($message)"
}

# All current sinks as reported by pactl. An empty list means the query failed.
def get-sinks []: nothing -> list {
    try {
        ^pactl --format=json list sinks | from json
    } catch {|error|
        log $"Error listing sinks: ($error.msg)"
        []
    }
}

# Resolve a sink by name, or null when it is gone.
def get-sink [name: string] {
    get-sinks | where name == $name | first
}

# Does this sink belong to a Sony WH/WF-1000XM4 headset?
def is-xm4-sink [sink: record]: nothing -> bool {
    let properties = $sink.properties? | default {}
    let haystack = (
        [
            $sink.description?
            $sink.name?
            ($properties | get -o "device.alias")
            ($properties | get -o "device.description")
        ]
        | each {|text| $text | default "" | str lowercase }
        | str join " "
    )
    let address = $properties | get -o "api.bluez5.address" | default "" | str uppercase
    let vendor = $properties | get -o "device.vendor.id" | default "" | str lowercase

    let by_address = ($address == ($known_mac | str uppercase))
    let by_model = ($haystack | str contains "1000xm4")
    let by_node_name = ($haystack | str contains ($known_mac | str replace --all ":" "_" | str lowercase))
    let by_vendor = ($haystack | str contains "xm4") and ($vendor | str contains $sony_vendor_id)

    $by_address or $by_model or $by_node_name or $by_vendor
}

# Average channel volume of a sink in percent, or null when unavailable.
def sink-volume-percent [sink: record] {
    let percentages = (
        $sink.volume?
        | default {}
        | values
        | each {|channel| $channel.value_percent? | default "" | str replace --all "%" "" }
        | where {|value| $value | is-not-empty }
        | each {|value| $value | into int }
    )
    if ($percentages | is-empty) {
        null
    } else {
        $percentages | math avg | math round
    }
}

def set-sink-volume [name: string, volume: string] {
    let result = (^pactl set-sink-volume $name $volume | complete)
    if $result.exit_code != 0 {
        log $"Failed to set volume on ($name): ($result.stderr | str trim)"
    }
}

# WirePlumber may overwrite the requested volume right after connecting, so
# check twice over ~0.5s and enforce the target again if it was restored.
def stabilize-volume [name: string, volume: string] {
    let target = $volume | str replace --all "%" "" | into int
    for delay in $stabilization_delays {
        sleep $delay
        let sink = get-sink $name
        if ($sink | is-empty) {
            return
        }
        let current = sink-volume-percent $sink
        if ($current != null) and ((($current - $target) | math abs) > 1) {
            log $"WirePlumber restored volume to ($current)%; enforcing ($volume) on ($name)"
            set-sink-volume $name $volume
        } else {
            log $"Volume confirmed at ($volume) on ($name)"
        }
    }
}

def handle-connected [sink: record, volume: string] {
    let description = $sink.description? | default $sink.name
    log $"Sony XM4 connected ($description): setting volume to ($volume)"
    set-sink-volume $sink.name $volume
    stabilize-volume $sink.name $volume
}

# Reconcile the tracked sinks with the currently connected ones and return the
# new set of XM4 sink names.
def sync-sinks [volume: string, known_sinks: list<string>]: nothing -> list<string> {
    let connected_sinks = (get-sinks | where {|sink| is-xm4-sink $sink })
    let names = ($connected_sinks | get name)

    for sink in $connected_sinks {
        if $sink.name not-in $known_sinks {
            handle-connected $sink $volume
        }
    }
    for name in ($known_sinks | where {|name| $name not-in $names }) {
        log $"Sony XM4 disconnected: ($name)"
    }

    $names
}

# Only sink/card lifecycles change which devices are present; routing, volume,
# and profile changes are ignored so manual adjustments stick.
def is-topology-event [line: string]: nothing -> bool {
    let device_event = ($line | str contains "on sink") or ($line | str contains "on card")
    let lifecycle = ($line | str contains "new") or ($line | str contains "remove")
    $device_event and $lifecycle
}

# Run the monitor. If pactl.subscribe dies the loop restarts it after a
# rescan, so transient PipeWire restarts do not end the service.
def main [--volume (-v): string = $default_volume] {
    log $"Starting Sony XM4 volume monitor \(target: ($volume))"

    mut known_sinks = (sync-sinks $volume [])
    loop {
        try {
            # `for` swallows errors from the stream source itself, so the
            # subscribe exit is logged below rather than caught here.
            for line in (^pactl subscribe | lines) {
                if (is-topology-event $line) {
                    $known_sinks = (sync-sinks $volume $known_sinks)
                }
            }
        } catch {|error|
            log $"Subscription error: ($error.msg)"
        }
        log "pactl subscribe stopped; restarting"
        sleep $rescan_delay
        $known_sinks = (sync-sinks $volume $known_sinks)
    }
}
