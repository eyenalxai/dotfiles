#!/usr/bin/env python3
"""
Monitor PipeWire/PulseAudio events and automatically set volume to 30%
when Sony WH-1000XM4 / WF-1000XM4 headphones are connected.
"""

import argparse
import json
import os
import signal
import subprocess
import sys
import threading
import time

DEFAULT_TARGET_VOLUME = "30%"
KNOWN_MAC = "AC:80:0A:EA:90:62"
SONY_VENDOR_ID = "054c"


def log(msg: str):
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{timestamp}] {msg}", flush=True)


def is_xm4_sink(sink: dict) -> bool:
    """Check if the given sink corresponds to Sony XM4 headphones."""
    props = sink.get("properties", {})
    desc = sink.get("description", "")
    name = sink.get("name", "")
    addr = props.get("api.bluez5.address", "")
    alias = props.get("device.alias", "")
    dev_desc = props.get("device.description", "")
    vendor = props.get("device.vendor.id", "")

    # Check MAC address
    if addr and addr.upper() == KNOWN_MAC.upper():
        return True

    # Check device strings for XM4 markers
    for text in [desc, name, alias, dev_desc]:
        tl = text.lower()
        if "1000xm4" in tl or "wh-1000xm4" in tl or "wf-1000xm4" in tl:
            return True

    # Check Sony vendor ID and XM4 in description
    if SONY_VENDOR_ID in vendor.lower() and "xm4" in desc.lower():
        return True

    # Check node name containing known MAC
    if KNOWN_MAC.replace(":", "_").upper() in name.upper():
        return True

    return False


def get_sinks() -> list:
    """Return all current sinks from pactl."""
    try:
        res = subprocess.run(
            ["pactl", "--format=json", "list", "sinks"],
            capture_output=True,
            text=True,
            check=True,
            timeout=5,
        )
        return json.loads(res.stdout)
    except Exception as e:
        log(f"Error listing sinks: {e}")
        return []


def get_sink_by_name(sink_name: str) -> dict | None:
    for s in get_sinks():
        if s.get("name") == sink_name:
            return s
    return None


def get_sink_volume_percent(sink: dict) -> int | None:
    """Return the average volume percentage of the sink, or None."""
    vol = sink.get("volume", {})
    percentages = []
    for ch_info in vol.values():
        if isinstance(ch_info, dict) and "value_percent" in ch_info:
            pct_str = ch_info["value_percent"].rstrip("%")
            try:
                percentages.append(int(pct_str))
            except ValueError:
                pass
    if percentages:
        return round(sum(percentages) / len(percentages))
    return None


def apply_volume(sink_name: str, target_vol: str):
    """Set sink volume to target percentage."""
    try:
        subprocess.run(
            ["pactl", "set-sink-volume", sink_name, target_vol],
            check=True,
            capture_output=True,
            timeout=5,
        )
    except Exception as e:
        log(f"Failed to set volume on {sink_name}: {e}")


def stabilize_volume(sink_name: str, target_vol: str, target_pct: int):
    """
    Check volume after short delays to ensure WirePlumber's route
    restoration does not overwrite the requested volume.
    Stops after stabilization period (~0.5s) to respect user's manual adjustments.
    """
    for delay in [0.15, 0.35]:
        time.sleep(delay)
        sink = get_sink_by_name(sink_name)
        if not sink:
            return
        current_pct = get_sink_volume_percent(sink)
        if current_pct is not None and abs(current_pct - target_pct) > 1:
            log(
                f"WirePlumber restored volume to {current_pct}%; enforcing {target_vol} on {sink_name}"
            )
            apply_volume(sink_name, target_vol)
        else:
            log(f"Volume confirmed at {target_vol} on {sink_name}")


class Xm4VolumeMonitor:
    def __init__(self, target_volume: str = DEFAULT_TARGET_VOLUME):
        self.target_volume = target_volume
        try:
            self.target_pct = int(target_volume.rstrip("%"))
        except ValueError:
            self.target_pct = 30
        self.active_sinks: set[str] = set()
        self.lock = threading.Lock()
        self.running = True

    def handle_sink_connected(self, sink_name: str, desc: str):
        log(f"Sony XM4 connected ({desc}): setting volume to {self.target_volume}")
        apply_volume(sink_name, self.target_volume)
        # Verify and stabilize in background
        t = threading.Thread(
            target=stabilize_volume,
            args=(sink_name, self.target_volume, self.target_pct),
            daemon=True,
        )
        t.start()

    def scan_sinks(self):
        with self.lock:
            current_sinks = get_sinks()
            current_xm4_sinks = {
                s["name"]: s.get("description", s["name"])
                for s in current_sinks
                if is_xm4_sink(s)
            }

            # Newly connected sinks
            for s_name, desc in current_xm4_sinks.items():
                if s_name not in self.active_sinks:
                    self.active_sinks.add(s_name)
                    self.handle_sink_connected(s_name, desc)

            # Removed sinks
            removed = self.active_sinks - set(current_xm4_sinks.keys())
            for r_name in removed:
                log(f"Sony XM4 disconnected: {r_name}")
                self.active_sinks.remove(r_name)

    def run(self):
        log(f"Starting Sony XM4 volume monitor (target: {self.target_volume})")
        # Initial scan on startup
        self.scan_sinks()

        while self.running:
            proc = None
            try:
                proc = subprocess.Popen(
                    ["pactl", "subscribe"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    bufsize=1,
                )
                self.sub_proc = proc

                for raw_line in proc.stdout:
                    if not self.running:
                        break
                    line = raw_line.strip()
                    # Trigger on sink/card additions, removals, or route changes
                    if any(
                        keyword in line
                        for keyword in [
                            "on sink",
                            "on card",
                        ]
                    ):
                        if "remove" in line or "new" in line:
                            self.scan_sinks()

            except Exception as e:
                log(f"Subscription error: {e}")
            finally:
                if proc and proc.poll() is None:
                    proc.terminate()
                    try:
                        proc.wait(timeout=2)
                    except subprocess.TimeoutExpired:
                        proc.kill()

            if self.running:
                time.sleep(2)
                self.scan_sinks()

    def stop(self):
        self.running = False
        if hasattr(self, "sub_proc") and self.sub_proc and self.sub_proc.poll() is None:
            self.sub_proc.terminate()


def main():
    parser = argparse.ArgumentParser(
        description="Set volume to 30% when Sony XM4 are connected"
    )
    parser.add_argument(
        "--volume",
        default=DEFAULT_TARGET_VOLUME,
        help="Target volume (default: 30%%)",
    )
    args = parser.parse_args()

    monitor = Xm4VolumeMonitor(target_volume=args.volume)

    def sig_handler(sig, frame):
        log("Shutting down Sony XM4 volume monitor...")
        monitor.stop()
        sys.exit(0)

    signal.signal(signal.SIGINT, sig_handler)
    signal.signal(signal.SIGTERM, sig_handler)

    monitor.run()


if __name__ == "__main__":
    main()
