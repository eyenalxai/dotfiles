#!/bin/sh
# Pacman owns this copy, so browse must not replace it with a downloaded
# release. It has no permission to write /usr/lib anyway and would only log
# failures. The environment variable overrides `browse update --mode`, so a
# user who wants the binary to manage itself exports it to notify or on.
: "${OPENCODE_BROWSER_AUTO_UPDATE:=off}"
export OPENCODE_BROWSER_AUTO_UPDATE
exec /usr/lib/opencode-browse/browse "$@"
