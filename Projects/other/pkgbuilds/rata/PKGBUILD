# Maintainer: ulezot

pkgname=rata
pkgver=0.7.0
pkgrel=1
pkgdesc='Linear issue tracking for agent workflows: triage, tickets and wayfinding from the terminal'
arch=('x86_64' 'aarch64')
url='https://github.com/eyenalxai/rata'
license=('MIT')
depends=('glibc')
makedepends=('bun')
# A compiled Bun binary carries an appended payload that `strip` breaks, and
# the build produces no debug info to split out.
options=('!strip' '!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/eyenalxai/rata/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6cac361c2113d59944be1acda6a529318f473a5e67aea13db7c29d47dc3a226c')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  # The prepare script only patches the local dev toolchain (tsgo, oxlint), so
  # skip it and the dev dependencies; the compile needs the runtime tree only.
  bun install --frozen-lockfile --production --ignore-scripts
  # A compiled Bun binary autoloads config from the working directory by
  # default: bunfig.toml, .env files, tsconfig.json and package.json. A
  # project-local preload would run arbitrary code inside rata, and a .env
  # could replace the Linear key. Disable all four at build time
  # (oven-sh/bun#25442, #44262).
  bun build --compile --minify \
    --no-compile-autoload-bunfig \
    --no-compile-autoload-dotenv \
    --no-compile-autoload-tsconfig \
    --no-compile-autoload-package-json \
    --outfile rata src/main.ts
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./rata --version | grep -q "^rata v$pkgver$"
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 rata "$pkgdir/usr/bin/$pkgname"
  install -dm755 "$pkgdir/usr/share/rata/drizzle"
  cp -r drizzle/. "$pkgdir/usr/share/rata/drizzle/"
  ./rata --completions bash > bash-completion
  ./rata --completions zsh > _rata
  ./rata --completions fish > rata.fish
  install -Dm644 bash-completion "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  install -Dm644 _rata "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
  install -Dm644 rata.fish "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
