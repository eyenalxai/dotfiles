# Maintainer: ulezot

pkgname=vingroto
pkgver=0.9.3
pkgrel=1
pkgdesc="TUI mail client with a Solid/OpenTUI interface and a background sync daemon"
arch=('x86_64' 'aarch64')
url="https://github.com/eyenalxai/vingroto"
license=('MIT')
depends=('ca-certificates' 'glibc' 'libsecret')
# bun 1.4 or newer: the build scripts embed assets into the standalone binaries
makedepends=('bun' 'git')
# !strip: the bundled JavaScript is appended to the Bun runtime, stripping risks corrupting it
# !debug: the Bun runtime ships without debug info
options=('!strip' '!debug')
install="$pkgname.install"

source=("$pkgname::git+ssh://git@github.com/eyenalxai/vingroto.git#tag=v$pkgver"
        "vingroto.service")
sha256sums=('SKIP'
            '953d6fa785b4b61f6775ee83c31579119b2a1d4e24d09126001d505513246b27')

build() {
  cd "$srcdir/$pkgname"
  bun install --frozen-lockfile
  bun run build
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 packages/client/dist/vingroto "$pkgdir/usr/bin/vingroto"
  install -Dm755 packages/server/dist/vingroto-server "$pkgdir/usr/bin/vingroto-server"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/vingroto.service" "$pkgdir/usr/lib/systemd/user/vingroto.service"
}
