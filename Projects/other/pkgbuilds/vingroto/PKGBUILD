# Maintainer: ulezot

pkgname=vingroto
pkgver=0.15.0
pkgrel=1
pkgdesc="TUI mail client with a Solid/OpenTUI interface and a background sync daemon"
arch=('x86_64' 'aarch64')
url="https://github.com/eyenalxai/vingroto"
license=('MIT')
depends=('ca-certificates' 'glibc' 'libsecret')
# xdg-open opens links from the reader in the user's browser
optdepends=('xdg-utils: open links from the reader in a browser')
# bun 1.4 or newer: the build scripts embed assets into the standalone binaries
makedepends=('bun>=1.4.0' 'git')
# !strip: the bundled JavaScript is appended to the Bun runtime, stripping risks corrupting it
# !debug: the Bun runtime ships without debug info
options=('!strip' '!debug')
install="$pkgname.install"

source=("$pkgname::git+ssh://git@github.com/eyenalxai/vingroto.git#tag=v$pkgver"
        "vingroto.service")
sha256sums=('6addd6c0301742b230666c088b3b751184ef3b080a6e61e2b0b1a85b3fde5721'
            '953d6fa785b4b61f6775ee83c31579119b2a1d4e24d09126001d505513246b27')

build() {
  cd "$srcdir/$pkgname"
  bun install --frozen-lockfile
  bun run build
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 packages/client/dist/vingroto "$pkgdir/usr/bin/vingroto"
  install -Dm755 packages/server/dist/vingroto-server "$pkgdir/usr/bin/vingroto-server"
  install -Dm644 packages/client/completions/vingroto.bash \
    "$pkgdir/usr/share/bash-completion/completions/vingroto"
  install -Dm644 packages/client/completions/_vingroto "$pkgdir/usr/share/zsh/site-functions/_vingroto"
  install -Dm644 packages/client/completions/vingroto.nu \
    "$pkgdir/usr/share/nushell/vendor/autoload/vingroto.nu"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/vingroto.service" "$pkgdir/usr/lib/systemd/user/vingroto.service"
}
